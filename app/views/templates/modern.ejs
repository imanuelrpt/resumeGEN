<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @page { size: A4; margin: 0; }
        body { font-family: 'Inter', sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    </style>
</head>
<body class="bg-gray-100 flex min-h-screen">
    <aside class="w-1/3 bg-blue-900 text-white p-4">
        <div class="mb-8">
            <% if (resume.photo) { %>
                <img src="<%= photoBase %>/<%= resume.photo %>" class="w-24 h-24 rounded-lg mb-4 mx-auto object-cover border-4 border-blue-700 shadow-xl">
            <% } else { %>
                <div class="w-20 h-20 bg-blue-800 rounded-full mb-4 mx-auto border-4 border-blue-700 flex items-center justify-center text-3xl font-bold uppercase">
                    <%= resume.nama_lengkap.split(' ').map(n => n[0]).join('') %>
                </div>
            <% } %>
            <h1 class="text-lg font-black uppercase leading-tight break-words text-left"><%= resume.nama_lengkap %></h1>
        </div>

        <section class="mb-10">
            <h2 class="text-blue-300 font-bold uppercase tracking-widest text-xs border-b border-blue-800 pb-2 mb-4">Contact</h2>
            <ul class="text-sm space-y-4">
                <li class="flex items-center gap-3">
                    <span><%= resume.email_resume %></span>
                </li>
                <li class="flex items-center gap-3">
                    <span><%= resume.phone %></span>
                </li>
                <li class="flex items-center gap-3">
                    <span><%= resume.alamat %></span>
                </li>
            </ul>
        </section>

        <% if (skills && skills.length > 0) { %>
        <section class="mb-10">
            <h2 class="text-blue-300 font-bold uppercase tracking-widest text-xs border-b border-blue-800 pb-2 mb-4">Skills</h2>
            <div class="flex flex-wrap gap-2">
                <% skills.forEach(skill => { %>
                    <span class="bg-blue-800 px-3 py-1 rounded-full text-xs"><%= skill.skill_name %></span>
                <% }) %>
            </div>
        </section>
        <% } %>
    </aside>

    <main class="w-2/3 bg-white p-12">
        <section class="mb-12">
            <h2 class="text-xl font-bold text-blue-900 border-b-4 border-blue-900 inline-block mb-6">Profile</h2>
            <p class="text-gray-600 leading-relaxed"><%= resume.summary %></p>
        </section>

        <% if (experience && experience.length > 0) { %>
        <section class="mb-12">
            <h2 class="text-xl font-bold text-blue-900 border-b-4 border-blue-900 inline-block mb-6">Experience</h2>
            <div class="space-y-8">
                <% experience.forEach(exp => { %>
                    <div>
                        <div class="flex justify-between items-start mb-1">
                            <h3 class="font-bold text-gray-900"><%= exp.company %></h3>
                            <span class="text-sm font-bold text-blue-700"><%= exp.year %></span>
                        </div>
                        <div class="text-blue-600 font-medium text-sm mb-2"><%= exp.position %></div>
                        <p class="text-gray-500 text-sm"><%= exp.description %></p>
                    </div>
                <% }) %>
            </div>
        </section>
        <% } %>

        <% if (education && education.length > 0) { %>
        <section>
            <h2 class="text-xl font-bold text-blue-900 border-b-4 border-blue-900 inline-block mb-6">Education</h2>
            <div class="space-y-6">
                <% education.forEach(edu => { %>
                    <div>
                        <div class="flex justify-between items-start mb-1">
                            <h4 class="font-bold text-gray-900"><%= edu.school %></h4>
                            <span class="text-sm font-bold text-blue-700"><%= edu.year %></span>
                        </div>
                        <div class="text-gray-500 text-sm"><%= edu.major %></div>
                    </div>
                <% }) %>
            </div>
        </section>
        <% } %>
    </main>
</body>
</html>
