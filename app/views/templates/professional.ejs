<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @page { size: A4; margin: 0; }
        body { font-family: 'Inter', sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    </style>
</head>
<body class="bg-white">
    <header class="bg-[#1e293b] text-white p-12 flex justify-between items-center">
        <div class="flex-1">
            <h1 class="text-4xl font-bold tracking-tight mb-2 uppercase"><%= resume.nama_lengkap %></h1>
            <div class="flex flex-wrap gap-4 text-xs font-medium text-slate-300 uppercase tracking-widest">
                <span><%= resume.email_resume %></span>
                <span>•</span>
                <span><%= resume.phone %></span>
                <span>•</span>
                <span><%= resume.alamat %></span>
            </div>
        </div>
        <% if (resume.photo) { %>
            <img src="<%= photoBase %>/<%= resume.photo %>" class="w-32 h-32 object-cover border-4 border-slate-700 shadow-2xl rounded-full">
        <% } %>
    </header>

    <div class="flex">
        <!-- Sidebar -->
        <aside class="w-1/3 bg-slate-50 p-10 border-r border-slate-200 min-h-screen">
            <section class="mb-10">
                <h2 class="text-xs font-bold text-slate-400 uppercase tracking-[0.2em] mb-4 border-b border-slate-200 pb-2">Skills</h2>
                <div class="flex flex-wrap gap-2">
                    <% skills.forEach(skill => { %>
                        <span class="bg-white border border-slate-200 text-slate-700 px-3 py-1 rounded text-xs font-semibold shadow-sm"><%= skill.skill_name %></span>
                    <% }) %>
                </div>
            </section>

            <% if (certificates && certificates.length > 0) { %>
            <section class="mb-10">
                <h2 class="text-xs font-bold text-slate-400 uppercase tracking-[0.2em] mb-4 border-b border-slate-200 pb-2">Certifications</h2>
                <div class="space-y-4">
                    <% certificates.forEach(cert => { %>
                        <div>
                            <div class="text-sm font-bold text-slate-800"><%= cert.cert_name %></div>
                            <div class="text-xs text-slate-500"><%= cert.year %></div>
                        </div>
                    <% }) %>
                </div>
            </section>
            <% } %>
        </aside>

        <!-- Main Content -->
        <main class="w-2/3 p-12">
            <section class="mb-12">
                <h2 class="text-xs font-bold text-blue-600 uppercase tracking-[0.2em] mb-4">Executive Summary</h2>
                <p class="text-slate-600 leading-relaxed text-sm italic border-l-4 border-blue-600 pl-4 bg-blue-50 py-3 rounded-r"><%= resume.summary %></p>
            </section>

            <% if (experience && experience.length > 0) { %>
            <section class="mb-12">
                <h2 class="text-xs font-bold text-blue-600 uppercase tracking-[0.2em] mb-6 border-b border-slate-100 pb-2">Professional Experience</h2>
                <div class="space-y-10">
                    <% experience.forEach(exp => { %>
                        <div>
                            <div class="flex justify-between items-baseline mb-2">
                                <h3 class="text-lg font-bold text-slate-900"><%= exp.position %></h3>
                                <span class="text-xs font-black text-slate-400 uppercase"><%= exp.year %></span>
                            </div>
                            <div class="text-sm font-bold text-blue-700 mb-3"><%= exp.company %></div>
                            <p class="text-slate-600 text-sm leading-relaxed whitespace-pre-wrap"><%= exp.description %></p>
                        </div>
                    <% }) %>
                </div>
            </section>
            <% } %>

            <% if (education && education.length > 0) { %>
            <section>
                <h2 class="text-xs font-bold text-blue-600 uppercase tracking-[0.2em] mb-6 border-b border-slate-100 pb-2">Academic Background</h2>
                <div class="space-y-6">
                    <% education.forEach(edu => { %>
                        <div>
                            <div class="flex justify-between items-baseline mb-1">
                                <h4 class="text-base font-bold text-slate-900"><%= edu.school %></h4>
                                <span class="text-xs font-bold text-slate-400"><%= edu.year %></span>
                            </div>
                            <div class="text-sm text-slate-600 font-medium"><%= edu.major %></div>
                        </div>
                    <% }) %>
                </div>
            </section>
            <% } %>
        </main>
    </div>
</body>
</html>
