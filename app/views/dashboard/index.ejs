<div class="container mx-auto px-4 py-10">
    <div class="flex justify-between items-center mb-10">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">My Resumes</h1>
            <p class="text-gray-500">Manage and create your professional resumes.</p>
        </div>
        <a href="/resume/create" class="bg-blue-600 text-white px-6 py-3 rounded-xl font-bold flex items-center gap-2 hover:bg-blue-700 transition shadow-lg shadow-blue-200">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Create New
        </a>
    </div>

    <!-- Resume List -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% if (resumes && resumes.length > 0) { %>
            <% resumes.forEach(resume => { %>
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
                    <div class="h-40 bg-gray-100 flex items-center justify-center">
                        <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    </div>
                    <div class="p-6">
                        <h3 class="font-bold text-lg mb-1"><%= resume.nama_lengkap || 'Untitled Resume' %></h3>
                        <p class="text-sm text-gray-400 mb-4">Last edited: <%= new Date(resume.created_at).toLocaleDateString() %></p>
                        <div class="flex gap-2">
                            <a href="/resume/edit/<%= resume.id %>" class="flex-1 bg-gray-50 text-gray-700 text-center py-2 rounded-lg font-medium hover:bg-gray-100 transition">Edit</a>
                            <a href="/resume/download/<%= resume.id %>" class="flex-1 bg-blue-50 text-blue-600 text-center py-2 rounded-lg font-medium hover:bg-blue-100 transition">Download</a>
                            <button onclick="deleteResume('<%= resume.id %>')" class="p-2 text-red-400 hover:text-red-600 transition">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                            </button>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div class="col-span-full bg-white rounded-2xl border-2 border-dashed border-gray-200 p-20 text-center">
                <div class="w-20 h-20 bg-gray-50 text-gray-300 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-2">No resumes yet</h3>
                <p class="text-gray-500 mb-8 max-w-xs mx-auto">Click the button above to create your first professional resume.</p>
                <a href="/resume/create" class="text-blue-600 font-bold hover:underline">Start creating &rarr;</a>
            </div>
        <% } %>
    </div>
</div>

<script>
    async function deleteResume(id) {
        if (confirm('Are you sure you want to delete this resume?')) {
            try {
                const response = await fetch(`/resume/delete/${id}`, { method: 'DELETE' });
                if (response.ok) {
                    window.location.reload();
                } else {
                    alert('Failed to delete resume');
                }
            } catch (err) {
                console.error(err);
                alert('An error occurred');
            }
        }
    }
</script>
